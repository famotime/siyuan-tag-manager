{
  "name": "siyuan-tag-manager",
  "version": "0.1.0",
  "type": "module",
  "description": "Professional tag asset management, visual styling, health hygiene, and multidimensional faceted search for SiYuan",
  "author": "Quincy Zou",
  "license": "MIT",
  "homepage": "https://github.com/famotime/siyuan-tag-manager",
  "repository": "https://github.com/famotime/siyuan-tag-manager",
  "scripts": {
    "dev": "vite build --watch",
    "release": "node ./release.js",
    "release:manual": "node ./release.js --mode=manual",
    "release:patch": "node ./release.js --mode=patch",
    "release:minor": "node ./release.js --mode=minor",
    "release:major": "node ./release.js --mode=major",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json --noUnusedLocals false --noUnusedParameters false"
  },
  "dependencies": {
    "pinyin-match": "^1.2.10",
    "vue": "^3.3.8"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.8.1",
    "@types/node": "^20.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.22.0",
    "eslint-plugin-format": "^1.0.1",
    "eslint-plugin-perfectionist": "^4.2.0",
    "fast-glob": "^3.2.12",
    "glob": "^11.0.1",
    "minimist": "^1.2.8",
    "rollup-plugin-livereload": "^2.0.5",
    "sass": "^1.62.1",
    "siyuan": "^1.2.8",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4",
    "vite": "^6.2.1",
    "vite-plugin-static-copy": "^2.3.2",
    "vite-plugin-zip-pack": "^1.0.5",
    "vitest": "^5.0.2"
  }
}
